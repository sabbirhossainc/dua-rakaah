# Copy to .env.local and fill in. Every variable here is server only: never give one a NEXT_PUBLIC_ prefix.

# Shared user-data database (bookmarks and sync). For local development use a file: no account or token needed.
#   TURSO_DATABASE_URL=file:data/user-dev.db
TURSO_DATABASE_URL=
# Only for a Turso (libsql://) database. Leave empty for a file: URL.
TURSO_AUTH_TOKEN=

# Auth.js: a long random string (for example `npx auth secret`), used to sign the session cookie.
AUTH_SECRET=
# Google OAuth client. Redirect URL: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signs the anonymous-device cookie. A long random string, different from AUTH_SECRET.
ANON_COOKIE_SECRET=

# Quran.com audio (Quran Foundation, https://api-docs.quran.foundation). Optional: leave all four empty to run without
# it. Set them at build time and at run time. Switch the credentials and both addresses together.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# Pre-live: https://prelive-oauth2.quran.foundation   Production: https://oauth2.quran.foundation
QF_OAUTH2_BASE_URL=
# Pre-live: https://apis-prelive.quran.foundation     Production: https://apis.quran.foundation
QF_API_BASE_URL=
